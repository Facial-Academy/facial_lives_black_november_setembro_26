# Cloudflare Pages — política de cache
#
# Fontes e imagens: conteúdo estável sob o mesmo nome. Quando um deles muda,
# o arquivo entra com outro nome (ex.: logo-fabrica-hof-612.webp), então pode
# ficar em cache longo com segurança.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# CSS e JS: troque o nome do arquivo a cada mudança (ver README). O max-age=0
# abaixo é o que pedimos, mas a zona entrega 31 dias. "immutable" aqui já
# causou a página servir CSS antigo depois de um deploy.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Cache-Control: public, max-age=3600
